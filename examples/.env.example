# ─── Workboard instance configuration ────────────────────────────────────────────────────────────────
# Copy to your instance directory (NOT the repository), fill in, and pass it with
#   docker compose --env-file /path/to/.env up -d
# Generate secrets with:  openssl rand -hex 32

# ── Where it runs ──
WORKBOARD_PORT=3000                 # host port (bound to WORKBOARD_BIND)
WORKBOARD_BIND=127.0.0.1            # keep loopback; expose through a TLS reverse proxy
# ABSOLUTE paths — compose resolves relative ones against the repository checkout, not this folder.
WORKBOARD_DATA_DIR=/home/you/workboard-instance/data   # tasks, people.json, schedule, shopping (back this up)
WORKBOARD_ENV_FILE=/home/you/workboard-instance/.env   # this file
# WORKBOARD_CONTAINER=workboard
# WORKBOARD_IMAGE=workboard:local

# Host names the server answers to (DNS-rebinding guard), comma separated. Include your public host name.
WORKBOARD_HOSTS=board.example.com,workboard:3000,workboard
# Base URL used in links inside WhatsApp messages
PUBLIC_URL=https://board.example.com

# ── Calendar ──
TZ=Asia/Jerusalem
WORKBOARD_WORKWEEK=sun-thu          # sun-thu | mon-fri | mon-sat | 0,1,2,3,4 (0 = Sunday)
WORKBOARD_WORK_HOURS=08:00-17:00    # when the "automatic" context means work
WORKBOARD_OWNER_NAME=               # display name when there is no people.json (single user)

# ── Agents (MCP) ──
# One token per person's agent: person:actor:token  (person ids from people.json; actor = name in the activity log)
WORKBOARD_AGENT_TOKENS=
# Or, single-user: a token for the default person's agent
WORKBOARD_AGENT_TOKEN=
# Maintenance tools that may see every space: actor:token
WORKBOARD_SERVICE_TOKENS=

# ── Delivery (reminders, digest, pairing codes) through each person's agent webhook ──
# Default person:
WORKBOARD_WEBHOOK_URL=              # e.g. http://hermes:8644/webhooks/workboard
WORKBOARD_WEBHOOK_SECRET=
# Other people: person|url|secret,…
WORKBOARD_WEBHOOKS=

# ── Development only ──
# WORKBOARD_DEV_NO_AUTH=1           # skip pairing (refused unless bound to loopback)
